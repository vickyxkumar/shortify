DATABASE_URL=jdbc:database_provider://database_server_location/database_name?user=database_username&password=database_password&sslmode=require&channelBinding=require
DATABASE_USERNAME=database_username
DATABASE_PASSWORD=database_password

JWT_SECRECT=random_string_more_than_256_character
JWT_EXPIRATION=time_in_ms

#redis env
REDIS_HOSTNAME=localhost
REDIS_PORT=6379
REDIS_TIMEOUT=2000

MACHINE_ID=1

#Kafka 
SERVER_URL=localhost:9092
PRODUCER_VALUE_SERIALIZER=org.springframework.kafka.support.serializer.JsonSerializer
PRODUCER_KEY_SERIALIZER=org.apache.kafka.common.serialization.StringSerializer

CONSUMER_GROUP_ID=analytics-group
CONSUMER_AUTO_OFFSET_RESET=earliest
CONSUMER_ENABLE_AUTO_COMMIT=false

CONSUMER_VALUE_SERIALIZER=org.springframework.kafka.support.serializer.ErrorHandlingDeserializer
CONSUMER_VALUE_DESERIALIZER_VALUE_DELEGATE=org.springframework.kafka.support.serializer.JsonDeserializer

CONSUMER_JSON_VALUE_DEFAULT_TYPE=com.url.shortify.dtos.ClickEventDTO
CONSUMER_JSON_TRUSTED_PACKAGE=*